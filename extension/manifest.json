{
  "manifest_version": 3,
  "name": "LinkedIn Job Scanner (dev)",
  "version": "0.1",
  "description": "Extract data while browsing LinkedIn Jobs",
  "permissions": ["storage", "downloads"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LinkedIn Job Scanner"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
